flowchart TB
    %% =========================================================================
    %% DIAGRAM 3: AGENTIC EXECUTION WORKFLOW
    %% AI for BI — Domain-Independent AI Data Scientist Agent
    %% Draw.io Compatible Mermaid Definition (flowchart TB)
    %% =========================================================================

    subgraph INTAKE ["1. Request Intake & Security Guardrails"]
        START(["Business Question Submitted"])
        SEC_CHECK{"Security & Guardrail Check\n(Prompt Injection / Destructive SQL)"}
        SEC_REJECT["Security Violation Interception\n(Return Failed Task & Refusal Notice)"]
    end

    subgraph CONTEXT_GATE ["2. Database-Isolated Context & Fingerprint Gate"]
        DB_RESOLVE["Resolve Active Database & Fingerprint\n(catalog.source_fingerprint)"]
        DB_SWITCH_CHECK{"Has Active Database Switched\nSince Last Turn in Session?"}
        PURGE_CACHE["Purge Previous Database Session Cache\n(Zero Cross-Database Leakage)"]
        LOAD_CONTEXT["Load Prior Turn Analytical Context\nKeyed strictly to (session_id, db_fingerprint)"]
    end

    subgraph PLANNING_STAGE ["3. Intent Understanding & Multi-Stage DAG Planning"]
        CLASSIFY["IntentClassifier (TF-IDF + Logistic Regression)\nDetect Single or Composite Analytical Cues"]
        DAG_FORMULATE["Formulate Multi-Agent Task DAG\nTask 1: Data Retrieval\nTasks 2..K: Analytical Specialists\nFinal Task: Critic Validation"]
        COMPOSITE_FLOW["Pipeline Ordering:\nDESCRIPTIVE -> DIAGNOSTIC -> PREDICTIVE -> PRESCRIPTIVE"]
    end

    subgraph RETRIEVAL_STAGE ["4. Schema-Grounded Data Retrieval Specialist"]
        EXEC_RETRIEVAL["DataRetrievalSpecialist.retrieve_data()\nAnalyticalPlanner creates Plan grounded in Catalog"]
        PLAN_VALID{"Is Plan Grounded &\nExecutable?"}
        PLAN_ABSTAIN["Abstain Retrieval & Downstream Tasks\n(Reason: Missing Schema Entities)"]
        EXEC_SQL["AnalyticalDataExtractor executes AST-guarded\nRead-Only SELECT against Active Adapter"]
        DATA_CHECK{"Query Execution Success &\nRow Count > 0?"}
        DATA_EMPTY_PRESCRIPTIVE{"Is Inquiry Prescriptive Baseline?"}
        DATA_ABSTAIN["Abstain Pipeline\n(Reason: Zero Records Found)"]
        DATA_READY["Construct pandas DataFrame\nExtract Column Metadata & Query Provenance"]
    end

    subgraph SPECIALIST_EXECUTION ["5. Sequential Analytical Specialist Stage Loop"]
        STAGE_ROUTER{"Next Stage in Composite Sequence"}

        subgraph DESCRIPTIVE_STAGE ["Stage: DESCRIPTIVE / SQL_LOOKUP"]
            RUN_DESC["DescriptiveAnalyticsEngine\nCompute KPIs, Totals, Deltas, Aggregations"]
        end

        subgraph DIAGNOSTIC_STAGE ["Stage: DIAGNOSTIC"]
            RUN_DIAG["DiagnosticSpecialist.run_diagnostic()\nIsolation Forest Anomalies & Driver Decomposition"]
            ATTACH_DIAG_DISC["Attach Non-Causal Observational Disclaimer\n(Reject Counterfactual Causality Claims)"]
        end

        subgraph PREDICTIVE_STAGE ["Stage: PREDICTIVE"]
            CHECK_TEMPORAL{"Temporal History Check\nLen(df) >= 6 Time Points?"}
            PRED_ABSTAIN["Safely Abstain Predictive Stage\n(Insufficient Historical Observations)"]
            RUN_PRED["PredictiveSpecialist.run_forecast()\nLightGBM vs ARIMA Tournament & Intervals"]
        end

        subgraph PRESCRIPTIVE_STAGE ["Stage: PRESCRIPTIVE"]
            CHECK_CONSTRAINTS{"Optimization Validity Check\nValid Decision Variables & Target?"}
            PRESC_ABSTAIN["Safely Abstain Prescriptive Stage\n(Unsupported Optimization Assumptions)"]
            RUN_PRESC["PrescriptiveSpecialist.run_optimization()\nSciPy SLSQP Constrained Minimize Allocation"]
            ATTACH_PRESC_DISC["Attach Safe Advisory Notice\n(Zero Autonomous Financial Mutation)"]
        end

        PARTIAL_HANDLER["Partial Completion Handler\nAggregate Completed Stages\nRecord Abstained/Failed Stages in Status Map"]
    end

    subgraph CRITIC_STAGE ["6. Critic Specialist & Faithfulness Validation"]
        RUN_CRITIC["CriticSpecialist.validate_narrative_and_claims()\nFaithfulnessValidator scans aggregated narrative"]
        EXTRACT_CLAIMS["Regex Extraction of Numerical Metrics,\nPercentages, Currency, and Directional Deltas"]
        MATCH_GROUND_TRUTH["Cross-Examine Claims against Ground-Truth\nComputed Metrics from Python Engines"]
        CHECK_CAUSAL_HEDGE{"Unhedged Causal Tokens Found?\n('proven cause', 'direct causal effect')"}
        FLAG_DISCREPANCY["Flag Factual / Causal Discrepancy\nApply Confidence Discount (-0.40 to -0.50)"]
        PASS_CRITIC["Validate Factual Faithfulness\nVerified Claims Ratio Bound to Evidence"]
    end

    subgraph SYNTHESIS_STAGE ["7. Executive Management Synthesis & Delivery"]
        SYNTHESIZE["Synthesize ManagementResponse Sections\n(Strictly Populates Executed Analytical Stages)"]
        CARD_WHAT["WHAT: Historical Performance & Descriptive KPIs"]
        CARD_WHY["WHY: Statistical Drivers, Anomalies & Limitations"]
        CARD_NEXT["WHAT NEXT: Forecast Projections & Intervals"]
        CARD_SOWHAT["SO WHAT: Prescriptive Scenarios & Advisory Recommendations"]
        UPDATE_SESSION["Update Database-Isolated Session Cache\nStore (session_id, db_fingerprint) -> Result"]
        DISPATCH_UI["Deliver to Frontend\n(REST Response or Real-time SSE Stream)"]
        END_NODE(["Management Decision Card Rendered in UI"])
    end

    %% Workflow Edges
    START --> SEC_CHECK
    SEC_CHECK -- "Injection / DML Detected" --> SEC_REJECT
    SEC_CHECK -- "Safe Query" --> DB_RESOLVE

    DB_RESOLVE --> DB_SWITCH_CHECK
    DB_SWITCH_CHECK -- "Database Changed" --> PURGE_CACHE
    DB_SWITCH_CHECK -- "Same Database" --> LOAD_CONTEXT
    PURGE_CACHE --> LOAD_CONTEXT

    LOAD_CONTEXT --> CLASSIFY
    CLASSIFY --> DAG_FORMULATE
    DAG_FORMULATE --> COMPOSITE_FLOW
    COMPOSITE_FLOW --> EXEC_RETRIEVAL

    EXEC_RETRIEVAL --> PLAN_VALID
    PLAN_VALID -- "Non-Executable" --> PLAN_ABSTAIN
    PLAN_VALID -- "Valid Plan" --> EXEC_SQL

    EXEC_SQL --> DATA_CHECK
    DATA_CHECK -- "Zero Rows" --> DATA_EMPTY_PRESCRIPTIVE
    DATA_EMPTY_PRESCRIPTIVE -- "Yes (Prescriptive)" --> DATA_READY
    DATA_EMPTY_PRESCRIPTIVE -- "No" --> DATA_ABSTAIN
    DATA_CHECK -- "Success" --> DATA_READY

    DATA_READY --> STAGE_ROUTER

    STAGE_ROUTER -- "DESCRIPTIVE" --> RUN_DESC
    STAGE_ROUTER -- "DIAGNOSTIC" --> RUN_DIAG
    RUN_DIAG --> ATTACH_DIAG_DISC
    STAGE_ROUTER -- "PREDICTIVE" --> CHECK_TEMPORAL
    CHECK_TEMPORAL -- "< 6 Points" --> PRED_ABSTAIN
    CHECK_TEMPORAL -- ">= 6 Points" --> RUN_PRED
    STAGE_ROUTER -- "PRESCRIPTIVE" --> CHECK_CONSTRAINTS
    CHECK_CONSTRAINTS -- "Invalid Tokens" --> PRESC_ABSTAIN
    CHECK_CONSTRAINTS -- "Valid" --> RUN_PRESC
    RUN_PRESC --> ATTACH_PRESC_DISC

    RUN_DESC --> PARTIAL_HANDLER
    ATTACH_DIAG_DISC --> PARTIAL_HANDLER
    PRED_ABSTAIN --> PARTIAL_HANDLER
    RUN_PRED --> PARTIAL_HANDLER
    PRESC_ABSTAIN --> PARTIAL_HANDLER
    ATTACH_PRESC_DISC --> PARTIAL_HANDLER

    PARTIAL_HANDLER --> RUN_CRITIC
    RUN_CRITIC --> EXTRACT_CLAIMS
    EXTRACT_CLAIMS --> MATCH_GROUND_TRUTH
    MATCH_GROUND_TRUTH --> CHECK_CAUSAL_HEDGE
    CHECK_CAUSAL_HEDGE -- "Found Unhedged Claim" --> FLAG_DISCREPANCY
    CHECK_CAUSAL_HEDGE -- "Faithful Claims" --> PASS_CRITIC
    FLAG_DISCREPANCY --> SYNTHESIZE
    PASS_CRITIC --> SYNTHESIZE

    SYNTHESIZE --> CARD_WHAT
    SYNTHESIZE --> CARD_WHY
    SYNTHESIZE --> CARD_NEXT
    SYNTHESIZE --> CARD_SOWHAT

    CARD_WHAT --> UPDATE_SESSION
    CARD_WHY --> UPDATE_SESSION
    CARD_NEXT --> UPDATE_SESSION
    CARD_SOWHAT --> UPDATE_SESSION

    UPDATE_SESSION --> DISPATCH_UI
    DISPATCH_UI --> END_NODE
    SEC_REJECT --> DISPATCH_UI
    PLAN_ABSTAIN --> DISPATCH_UI
    DATA_ABSTAIN --> DISPATCH_UI

