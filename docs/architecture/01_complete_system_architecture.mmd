flowchart TB
    %% =========================================================================
    %% DIAGRAM 1: COMPLETE SYSTEM ARCHITECTURE
    %% AI for BI — Domain-Independent AI Data Scientist Agent
    %% Draw.io Compatible Mermaid Definition (flowchart TB)
    %% =========================================================================

    subgraph PRESENTATION ["1. User & Client Presentation Layer"]
        USER["Business User / Decision Maker"]
        
        subgraph FRONTEND ["Next.js 14 / React Frontend (Port 3001)"]
            UI_INPUT["ChatInput Component (Natural Language Query)"]
            UI_STEPPER["StreamingStepper Component (Task DAG & Timing)"]
            UI_MGMT["ManagementResponseView (WHAT / WHY / NEXT / SO WHAT)"]
            UI_PLOTLY["PlotlyChartRenderer (Interactive BI Visualizations)"]
            UI_OBS["ObservabilityDashboard & SchemaReadinessSection"]
            UI_DRAWER["SessionsDrawer (Conversational History)"]
        end
    end

    subgraph API_LAYER ["2. FastAPI Backend & Transport Gateway (Port 8001)"]
        API_ENTRY["FastAPI Application Entry (main.py)"]
        MW_REQ["RequestIdMiddleware (Tracing & Latency Headers)"]
        MW_CORS["CORSMiddleware (Origin Validation & Regex)"]
        
        subgraph ENDPOINTS ["API Endpoints (api/v1/endpoints)"]
            EP_SUPERVISE["POST /api/v1/agentic/supervise (REST)"]
            EP_STREAM["POST /api/v1/agentic/stream (SSE Events)"]
            EP_CHAT["POST /api/v1/chat/query & /stream"]
            EP_SCHEMA["GET /api/v1/schema/status & /tables"]
            EP_READY["GET /api/v1/ready & /health"]
            EP_OPS["GET /api/v1/ops/traces & /telemetry"]
        end
    end

    subgraph ORCHESTRATION ["3. Autonomous Agentic Orchestration Subsystem"]
        SUPERVISOR["AgenticSupervisor (supervisor.py)"]
        GUARD_INJ["Security Guardrail: detect_prompt_injection"]
        SESSION_MEM["Database-Isolated Session Cache (session_id, db_fp)"]
        
        subgraph PLANNING ["Intent Understanding & Analytical Planning"]
            INTENT_CLF["IntentClassifier (TF-IDF + LogisticRegression)"]
            PLANNER["AnalyticalPlanner (Fact/Dimension & FK Ranking)"]
        end
    end

    subgraph SPECIALISTS ["4. Specialist Analytical Agents (Delegated Interfaces)"]
        SPEC_RETRIEVAL["DataRetrievalSpecialist (Schema Retrieval & Extraction)"]
        SPEC_DIAGNOSTIC["DiagnosticSpecialist (Drivers, Anomalies, Non-Causal Hedges)"]
        SPEC_PREDICTIVE["PredictiveSpecialist (Forecasting & Prediction Intervals)"]
        SPEC_PRESCRIPTIVE["PrescriptiveSpecialist (SciPy SLSQP Constrained Optimization)"]
        SPEC_CRITIC["CriticSpecialist (Faithfulness & Claim Verification)"]
    end

    subgraph ENGINES ["5. Deterministic Analytical & Statistical Engines"]
        ENG_DESC["DescriptiveAnalyticsEngine (KPIs, Deltas, Aggregations)"]
        ENG_DIAG["DiagnosticAnalyticsEngine (Isolation Forest & MAD Z-Scores)"]
        ENG_PRED["PredictiveAnalyticsEngine (LightGBM vs ARIMA Tournament)"]
        ENG_PRESC["PrescriptiveAnalyticsEngine (SciPy SLSQP / linprog Minimize)"]
        ENG_FAITH["FaithfulnessValidator (Regex Numbers, Percentages, Currency)"]
    end

    subgraph RETRIEVAL ["6. Persistent Hybrid Schema Retrieval Subsystem"]
        HYBRID_RET["HybridSchemaRetriever (Reciprocal Rank Fusion k=60)"]
        BM25_RET["PersistentBM25Retriever (Lexical Precision)"]
        LANCEDB_STORE["LanceDBVectorStore (Dense Vector Similarity)"]
        FASTEMBED["FastEmbedProvider (BAAI/bge-small-en-v1.5 ONNX Local)"]
        VALUE_LINK["ValueLinker (Low-Cardinality Categorical Literals)"]
        SEMANTIC_ENG["DynamicSemanticEngine (Catalog Metric Metadata)"]
        FK_GRAPH["1-Hop Foreign Key Graph Expansion"]
    end

    subgraph SQL_PIPELINE ["7. SQL Generation, AST Validation & Execution"]
        SQL_EXTRACTOR["AnalyticalDataExtractor (Query Synthesis)"]
        SQL_VALIDATOR["SQLValidator (sqlglot Dialect AST Parser)"]
        READONLY_POLICY["4-Tier Read-Only Policy Enforcement"]
        SQL_EXECUTOR["SQLExecutor (Timeout & Row Bounding)"]
    end

    subgraph ADAPTERS ["8. Multi-Engine Database Abstraction Layer"]
        DB_MANAGER["DatabaseConnectionManager (Single Active DB Invariant)"]
        ADAPT_SQLITE["SQLiteAdapter (URI mode=ro + PRAGMA query_only=ON)"]
        ADAPT_POSTGRES["PostgresAdapter (psycopg3 + READ ONLY Session)"]
        ADAPT_MYSQL["MySQLAdapter (pymysql + TRANSACTION READ ONLY)"]
    end

    subgraph DATA_STORES ["9. Physical Databases & Storage"]
        DB_SQLITE[("Connected SQLite Database Warehouse (Strict Read-Only)")]
        DB_POSTGRES[("Connected PostgreSQL Enterprise Warehouse")]
        DB_MYSQL[("Connected MySQL Enterprise Warehouse")]
        STORE_APP[("agent_app.sqlite (Traces, Configs, Memory)")]
        STORE_LANCEDB[("data/lancedb/ (Dense Vector Table Embeddings)")]
        STORE_BM25[("data/bm25/ (Persistent BM25 Inverted Index)")]
        CACHE_CATALOG[("data/active_catalog.json (Introspected Schema)")]
    end

    subgraph LLM_INFRA ["10. LLM Provider Integration Gateway"]
        LLM_FACTORY["LLM Factory: get_llm_provider()"]
        PROV_OLLAMA["OllamaLLMProvider (Local qwen3:4b via HTTP)"]
        PROV_GEMINI["GeminiProvider (google-genai SDK: gemini-3.5-flash-lite)"]
        PROV_OPENAI["OpenAIProvider (AsyncOpenAI SDK: gpt-4o-mini)"]
        PROV_MOCK["MockLLMProvider (Deterministic Grounded Fallback)"]
    end

    %% Flow Connections
    USER --> UI_INPUT
    UI_INPUT --> EP_SUPERVISE
    UI_INPUT --> EP_STREAM
    EP_SUPERVISE --> API_ENTRY
    EP_STREAM --> API_ENTRY
    API_ENTRY --> MW_REQ
    MW_REQ --> SUPERVISOR

    SUPERVISOR --> GUARD_INJ
    SUPERVISOR --> SESSION_MEM
    SUPERVISOR --> INTENT_CLF
    SUPERVISOR --> PLANNER

    PLANNER --> HYBRID_RET
    HYBRID_RET --> BM25_RET
    HYBRID_RET --> LANCEDB_STORE
    LANCEDB_STORE -.-> FASTEMBED
    HYBRID_RET --> FK_GRAPH
    PLANNER --> VALUE_LINK
    PLANNER --> SEMANTIC_ENG

    SUPERVISOR --> SPEC_RETRIEVAL
    SPEC_RETRIEVAL --> SQL_EXTRACTOR
    SQL_EXTRACTOR --> SQL_VALIDATOR
    SQL_VALIDATOR --> READONLY_POLICY
    READONLY_POLICY --> SQL_EXECUTOR
    SQL_EXECUTOR --> DB_MANAGER

    DB_MANAGER --> ADAPT_SQLITE
    DB_MANAGER --> ADAPT_POSTGRES
    DB_MANAGER --> ADAPT_MYSQL
    ADAPT_SQLITE --> DB_SQLITE
    ADAPT_POSTGRES -.-> DB_POSTGRES
    ADAPT_MYSQL -.-> DB_MYSQL

    SQL_EXECUTOR --> SPEC_RETRIEVAL
    SPEC_RETRIEVAL --> SUPERVISOR

    %% Analytical Specialist Flow
    SUPERVISOR --> SPEC_DIAGNOSTIC
    SUPERVISOR --> SPEC_PREDICTIVE
    SUPERVISOR --> SPEC_PRESCRIPTIVE
    SPEC_DIAGNOSTIC --> ENG_DIAG
    SPEC_PREDICTIVE --> ENG_PRED
    SPEC_PRESCRIPTIVE --> ENG_PRESC
    ENG_DESC -.-> SPEC_RETRIEVAL

    %% Critic Verification Flow
    SPEC_DIAGNOSTIC --> SPEC_CRITIC
    SPEC_PREDICTIVE --> SPEC_CRITIC
    SPEC_PRESCRIPTIVE --> SPEC_CRITIC
    SPEC_CRITIC --> ENG_FAITH
    ENG_FAITH --> SUPERVISOR

    %% LLM Invocations
    SUPERVISOR -.-> LLM_FACTORY
    LLM_FACTORY --> PROV_OLLAMA
    LLM_FACTORY -.-> PROV_GEMINI
    LLM_FACTORY -.-> PROV_OPENAI
    LLM_FACTORY -.-> PROV_MOCK

    %% Telemetry & Storage Persistence
    SUPERVISOR --> STORE_APP
    LANCEDB_STORE --> STORE_LANCEDB
    BM25_RET --> STORE_BM25
    PLANNER --> CACHE_CATALOG

    %% Response Delivery
    SUPERVISOR --> UI_MGMT
    SUPERVISOR --> UI_STEPPER
    SUPERVISOR --> UI_PLOTLY
    UI_MGMT --> USER
    UI_PLOTLY --> USER
