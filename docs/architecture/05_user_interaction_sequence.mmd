sequenceDiagram
    autonumber
    %% =========================================================================
    %% DIAGRAM 5: USER INTERACTION AND API SEQUENCE
    %% AI for BI — Domain-Independent AI Data Scientist Agent
    %% Draw.io Compatible Mermaid Definition (sequenceDiagram)
    %% =========================================================================

    actor User as Business User
    participant FE as Next.js Frontend (ChatInterface)
    participant API as FastAPI Gateway (agentic.py)
    participant SUP as AgenticSupervisor (supervisor.py)
    participant RET as DataRetrievalSpecialist
    participant DB as Active Relational Database (SQLite / Postgres / MySQL)
    participant SPEC as Analytical Specialists (Diag / Pred / Presc)
    participant CRIT as CriticSpecialist (faithfulness.py)
    participant LLM as LLM Provider (Ollama / Gemini)
    participant UI as ManagementResponseView

    %% Turn Initiation
    User->>FE: Enters natural language question in ChatInput
    activate FE
    FE->>FE: Generate client turnId, display optimistic user turn

    alt SSE Streaming Mode (POST /api/v1/agentic/stream)
        FE->>API: POST /api/v1/agentic/stream {question, session_id}
        activate API
        API->>SUP: supervise(question, session_id, catalog)
        activate SUP

        SUP->>SUP: Guardrail Check: detect_prompt_injection()
        SUP->>SUP: Session Fingerprint Isolation Check (invalidate if DB switched)
        SUP->>SUP: IntentClassifier.classify() & form multi-stage Task DAG

        API-->>FE: SSE Event: 'progress' {type: 'planning', message: 'Supervisor analyzing...'}
        FE->>FE: Update StreamingStepper (Planning state active)

        %% Task 1: Data Retrieval
        SUP->>RET: retrieve_data(plan, catalog)
        activate RET
        RET->>RET: AnalyticalDataExtractor synthesizes minimal SELECT
        RET->>RET: SQLValidator parses AST with sqlglot & applies LIMIT 1000
        RET->>DB: Execute read-only query (URI mode=ro, PRAGMA query_only=ON)
        activate DB
        DB-->>RET: Tabular rows & execution latency (ms)
        deactivate DB
        RET-->>SUP: (success=True, df, executed_queries, provenance_meta)
        deactivate RET

        API-->>FE: SSE Event: 'task_progress' {specialist: 'DATA_RETRIEVAL', status: 'COMPLETED', duration_ms}
        FE->>FE: StreamingStepper marks Data Retrieval complete with latency pill

        %% Task 2..K: Analytical Specialists
        loop Sequential Composite Stages (Desc -> Diag -> Pred -> Presc)
            SUP->>SPEC: Execute stage specialist (df, stage_plan, executed_queries)
            activate SPEC
            
            alt Diagnostic Stage
                SPEC->>SPEC: DiagnosticAnalyticsEngine: Isolation Forest & driver ranking
                SPEC->>SPEC: Attach mandatory non-causal observational disclaimer
            else Predictive Stage
                SPEC->>SPEC: Temporal check: len(df) >= 6 points (or safely abstain)
                SPEC->>SPEC: LightGBM vs ARIMA tournament, sMAPE backtest, intervals
            else Prescriptive Stage
                SPEC->>SPEC: Validate constraints, derive empirical groupby efficiencies
                SPEC->>SPEC: SciPy SLSQP minimize resource allocation & trade-offs
                SPEC->>SPEC: Attach safe advisory notice (no auto financial mutation)
            end

            SPEC-->>SUP: StandardizedAnalyticalResult (metrics, findings, limitations)
            deactivate SPEC

            API-->>FE: SSE Event: 'task_progress' {specialist: stage_name, status: 'COMPLETED', duration_ms}
            FE->>FE: StreamingStepper marks analytical specialist complete
        end

        %% Final Task: Critic Validation
        SUP->>CRIT: validate_narrative_and_claims(narrative, computed_metrics)
        activate CRIT
        CRIT->>CRIT: Regex extract numerical, percentage, monetary & direction claims
        CRIT->>CRIT: Cross-examine claims against computed ground-truth metrics
        CRIT->>CRIT: Intercept unhedged causal statements ('proven cause' -> flag)
        CRIT-->>SUP: FaithfulnessReport (is_faithful, verified_claims, discount)
        deactivate CRIT

        API-->>FE: SSE Event: 'task_progress' {specialist: 'CRITIC', status: 'COMPLETED', duration_ms}
        FE->>FE: StreamingStepper marks Critic verification complete

        %% Optional LLM Narrative Polish (if configured)
        opt LLM Enabled (Ollama qwen3:4b or Gemini)
            SUP->>LLM: Optional summary generation / executive polish
            activate LLM
            LLM-->>SUP: Polished executive phrasing
            deactivate LLM
        end

        %% Synthesis & Delivery
        SUP->>SUP: Synthesize ManagementResponse (populate WHAT, WHY, NEXT, SO WHAT)
        SUP->>SUP: Cache prior context under (session_id, db_fingerprint)
        SUP-->>API: SupervisorExecutionResult
        deactivate SUP

        API-->>FE: SSE Event: 'result' {management_response, tasks, metrics}
        deactivate API

    else Synchronous REST Fallback (POST /api/v1/agentic/supervise)
        FE->>API: POST /api/v1/agentic/supervise {question, session_id}
        activate API
        API->>SUP: supervise(...)
        activate SUP
        SUP-->>API: SupervisorExecutionResult
        deactivate SUP
        API-->>FE: HTTP 200 {success: true, data: SupervisorExecutionResult}
        deactivate API
    end

    %% UI Rendering
    FE->>UI: Render SupervisorExecutionResult
    activate UI
    UI->>UI: Render WHAT Executive Decision Card (historical KPIs & deltas)
    UI->>UI: Render WHY Executive Decision Card (statistical drivers & non-causal note)
    UI->>UI: Render WHAT NEXT Decision Card (forecast projections & prediction bounds)
    UI->>UI: Render SO WHAT Decision Card (prescriptive optimization & advisory disclaimer)
    UI->>UI: Render Specialist Task Execution Stepper with real timings
    UI->>UI: Render Grounded Evidence Inspector (columns, SQL, verified claims)
    UI-->>User: Fully rendered interactive executive decision brief
    deactivate UI
    deactivate FE
