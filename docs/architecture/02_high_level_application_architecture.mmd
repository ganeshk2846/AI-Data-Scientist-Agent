    classDef l3Class fill:#f3e5f5,stroke:#7b1fa2,stroke-width:1.5px,color:#4a148c;
    classDef l4Class fill:#fff3e0,stroke:#f57c00,stroke-width:1.5px,color:#e65100;
    classDef l5Class fill:#e0f2f1,stroke:#00796b,stroke-width:1.5px,color:#004d40;
    classDef l6Class fill:#fbe9e7,stroke:#d84315,stroke-width:1.5px,color:#bf360c;
    classDef l7Class fill:#e8f5e9,stroke:#388e3c,stroke-width:1.5px,color:#1b5e20;
    classDef l8Class fill:#fce4ec,stroke:#c2185b,stroke-width:1.5px,color:#880e4f;

    class AppShell,ChatInterface,ExecutiveOverview,CatalogBrowser,TelemetryDashboard,SystemDiagnostics,ConnectionManager l1Class;
    class ApiGateway,SecurityGate,RestRouter,SseStreaming l2Class;
    class Supervisor,IntentClassifier,EntityExtractor,TaskPlanner,WorkflowOrchestrator,DataRetrievalAgent,DiagnosticAgent,PredictiveAgent,PrescriptiveAgent,CriticAgent,ConversationalMemory l3Class;
    class DataDiscovery,DescriptiveAnalytics,DiagnosticAnalytics,ImpactAnalytics,PredictiveAnalytics,ScenarioAnalytics,PrescriptiveAnalytics,FaithfulnessCritic l4Class;
    class HybridRetriever,DenseSearch,LexicalSearch,RankFusion,GraphExpander,ValueLinker,SemanticLayer l5Class;
    class ConnectionManagerCore,SqlAstValidator,SqlRepairLoop,SqlExecutor,SqliteAdapter,PostgresAdapter,MysqlAdapter l6Class;
    class ObservabilityTracer,AppDatabase,VectorStorage,LexicalIndex,CatalogCache l7Class;
    class GroqCloud,EnterpriseWarehouses l8Class;

