# =========================================================================
# GITIGNORE - AI for BI Data Scientist Agent
# Keeps GitHub repository clean from caches, databases, logs, builds & secrets
# =========================================================================

# --- Secrets, Credentials & Local Config ---
.env
.env.local
.env.*.local
*.env
secrets.*
*.pem
*.key
*.pfx
*.p12
*.cert
*.crt
credentials.json
# Ensure template config is always tracked
!.env.example

# --- Python, Testing & Caching ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/
venv/
.venv/
env/
ENV/
*.egg-info/
*.egg
.eggs/

# --- Frontend & Node.js ---
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
.turbo/
.npm/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Databases, Storage & State ---
# Exclude raw warehouses, local sqlite instances and lock/journal files
*.db
*.db-*
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
ecommerce.sqlite
ecommerce.db
agent_app.sqlite

# --- Runtime Caches & Vector Stores ---
# Application generated schema catalogs, BM25 indices and LanceDB embeddings
/data/
data/
backend/data/active_catalog.json
*.lance/
*.parquet
*.arrow
*.duckdb

# Keep golden evaluation test fixtures
!backend/data/gold_evaluation_set.json

# --- ML Model Weights & Cache ---
fastembed_cache/
huggingface_cache/
models/
*.onnx
*.safetensors
*.bin
*.pt
*.pth

# --- Logs & Temp Directories ---
*.log
logs/
.cache/
*.cache
tmp/
temp/
scratch/
*.tmp
*.bak

# --- OS & Editors ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
