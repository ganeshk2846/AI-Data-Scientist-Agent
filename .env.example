# ==============================================================================
# AI-Powered Data Scientist Agent for Business Intelligence (AI for BI)
# Environment Configuration Template (.env.example)
#
# DO NOT store production credentials, secrets, or actual API keys in this file.
# Copy this file to `.env` and configure with your local environment values.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Business Warehouse Database (Read-Only)
ECOMMERCE_DB_PATH=ecommerce.sqlite

# Agent Application Store (Writable local state/checkpoints/memory)
APP_DB_PATH=agent_app.sqlite

# LLM Provider Configuration (Optional at startup; system reports when unconfigured)
# Supported options: openai, anthropic, gemini, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
