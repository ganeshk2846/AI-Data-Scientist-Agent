# ==============================================================================
# AI-Powered Data Scientist Agent for Business Intelligence (AI for BI)
# Environment Configuration Template (.env.example)
#
# DO NOT store production credentials, secrets, or actual API keys in this file.
# Copy this file to `.env` and configure with your local environment values.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8001

# Business Warehouse Database (Read-Only)
ECOMMERCE_DB_PATH=ecommerce.db

# Agent Application Store (Writable local state/checkpoints/memory)
APP_DB_PATH=agent_app.sqlite

# Groq LLM Configuration (Single Supported Provider)
# Set your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
